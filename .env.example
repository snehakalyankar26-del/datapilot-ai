# --- Google Gemini (choose ONE) ---------------------------------------------
# Option A: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Option B: Vertex AI (uses Application Default Credentials / Cloud Run service account)
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Security ------------------------------------------------------------------
# Comma-separated access keys. Leave empty to disable auth for local demos.
APP_API_KEYS=
ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_PER_MIN=30
MAX_UPLOAD_MB=10
QUERY_TIMEOUT_MS=3000
RESULT_ROW_LIMIT=200

# --- Agent ------------------------------------------------------------------
MAX_REPAIR_ATTEMPTS=2
CACHE_TTL_S=900
